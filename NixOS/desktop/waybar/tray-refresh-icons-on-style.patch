+void Item::queueIconRefresh() {
+  if (!ready_ || icon_refresh_.connected() ||
+      (icon_name.empty() && attention_icon_name.empty() && overlay_icon_name.empty() &&
+       attention_movie_name.empty())) {
+    return;
+  }
+  // GtkImage contains a rasterized Cairo surface, not the icon name. Wait
+  // for GTK's style update, then resolve named icons again without making the
+  // client re-register its tray item or waiting for a configure event.
+  icon_refresh_ = Glib::signal_idle().connect(sigc::mem_fun(*this, &Item::refreshIcon));
+}
+
+bool Item::refreshIcon() {
+  updateImage();
+  return false;
