+
+bool AModule::handleTouchTap(GdkEventTouch* e) {
+  if (e->type == GDK_TOUCH_BEGIN) {
+    if (tap_sequence_ != nullptr) {
+      tap_valid_ = false;
+    } else {
+      tap_sequence_ = e->sequence;
+      tap_x_ = e->x;
+      tap_y_ = e->y;
+      tap_valid_ = true;
+    }
+  } else if (e->sequence == tap_sequence_ && tap_sequence_ != nullptr) {
+    if (gtk_drag_check_threshold(GTK_WIDGET(event_box_.gobj()), tap_x_, tap_y_, e->x, e->y))
+      tap_valid_ = false;
+    if (e->type == GDK_TOUCH_END || e->type == GDK_TOUCH_CANCEL) {
+      const bool activate = e->type == GDK_TOUCH_END && tap_valid_ && e->x >= 0 && e->y >= 0 &&
+                            e->x < event_box_.get_allocated_width() &&
+                            e->y < event_box_.get_allocated_height();
+      tap_sequence_ = nullptr;
+      tap_valid_ = false;
+      if (activate) {
+        pid_children_.push_back(util::command::forkExec(config_["on-touch-tap"].asString()));
+      }
+    }
+  }
+  return true;
 }
 
