input {
    mod-key "Alt"
    // Disable Niri's built-in suspend binding; use the lock binding below.
    disable-power-key-handling

    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
    }
}
layout {
    gaps 14
    center-focused-column "never"
    always-center-single-column
    default-column-display "tabbed"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width {
        proportion 0.5
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        width 3
        active-color "#cba6f7"
        inactive-color "rgba(0,0,0,0)"
    }
    shadow {
        on
        softness 10
        spread 10
        offset x=0 y=5
    }
    tab-indicator {
        off
    }
    insert-hint {
        color "#f9e2af80"
    }
}
overview {
    backdrop-color "#1e1e2e"
}
// Niri still owns image/png on the clipboard, but never writes a PNG file.
screenshot-path null
hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
layer-rule {
    match namespace="keke-waybar-panel"
    // A transparent input-dismiss surface fills the monitor. Only the GTK
    // card paints a background/rounded shadow; never decorate the full layer.
    opacity 1.0
    shadow {
        off
    }
}
layer-rule {
    match namespace="waybar"
    geometry-corner-radius @WAYBAR_RADIUS@
}
layer-rule {
    match namespace="waybar"
    match namespace="rofi"
    opacity 0.8
    shadow {
        on
        softness 10
        spread 10
        offset x=0 y=5
    }
}
layer-rule {
    match namespace="rofi"
    geometry-corner-radius 10
}
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    draw-border-with-background false
}
// Snipaste image pins must retain their requested size, not become tiled.
window-rule {
    match app-id=r#"(?i)snipaste"#
    open-floating true
}

binds {
    // SNIPASTE_BINDINGS
    Mod+Return {
        spawn "ghostty"
    }
    Mod+D {
        spawn "rofi" "-show" "drun"
    }
    Mod+L hotkey-overlay-title="Lock screen" {
        spawn "screen-lock"
    }
    Super+L hotkey-overlay-title=null {
        spawn "screen-lock"
    }
    XF86PowerOff repeat=false allow-inhibiting=false hotkey-overlay-title="Lock screen" {
        spawn "screen-lock"
    }
    Print hotkey-overlay-title="Copy screenshot region" {
        screenshot
    }
    Super+Shift+S hotkey-overlay-title="Copy screenshot region" {
        screenshot
    }
    Ctrl+Print hotkey-overlay-title="Copy full screen" {
        screenshot-screen
    }
    Alt+Print hotkey-overlay-title="Copy focused window" {
        screenshot-window
    }
    // Standard media keysyms, independent of the keyboard or its Fn layer.
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "@MEDIA_NOTIFY@" "volume" "up"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "@MEDIA_NOTIFY@" "volume" "down"
    }
    XF86AudioMute repeat=false allow-when-locked=true {
        spawn "@MEDIA_NOTIFY@" "volume" "mute"
    }
    XF86AudioMicMute repeat=false allow-when-locked=true {
        spawn "@MEDIA_NOTIFY@" "mic" "mute"
    }
    XF86AudioPlay repeat=false allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }
    XF86AudioPause repeat=false allow-when-locked=true {
        spawn "playerctl" "pause"
    }
    XF86AudioStop repeat=false allow-when-locked=true {
        spawn "playerctl" "stop"
    }
    XF86AudioPrev repeat=false allow-when-locked=true {
        spawn "playerctl" "previous"
    }
    XF86AudioNext repeat=false allow-when-locked=true {
        spawn "playerctl" "next"
    }
    XF86AudioRewind allow-when-locked=true {
        spawn "playerctl" "position" "10-"
    }
    XF86AudioForward allow-when-locked=true {
        spawn "playerctl" "position" "10+"
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "@MEDIA_NOTIFY@" "brightness" "up"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "@MEDIA_NOTIFY@" "brightness" "down"
    }
    Mod+M {
        maximize-column
    }
    Mod+Q {
        close-window
    }
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Ctrl+1 {
        move-column-to-workspace 1
    }
    Mod+Ctrl+2 {
        move-column-to-workspace 2
    }
    Mod+Ctrl+3 {
        move-column-to-workspace 3
    }
    Mod+Ctrl+4 {
        move-column-to-workspace 4
    }
    Mod+Ctrl+5 {
        move-column-to-workspace 5
    }
    Mod+Ctrl+6 {
        move-column-to-workspace 6
    }
    Mod+Ctrl+7 {
        move-column-to-workspace 7
    }
    Mod+Ctrl+8 {
        move-column-to-workspace 8
    }
    Mod+Ctrl+9 {
        move-column-to-workspace 9
    }
}
