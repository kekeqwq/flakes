// Merged into the main Nix-managed niri config at build time.
// Keep every replacement external display at the streaming origin, even when
// its EDID is new. Otherwise niri auto-places it past eDP-1, changing input offsets.
output "DP-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

// Known EDID profiles below retain their explicit capture-safe settings.
output "A/Vaux Electronics AVT GC553PRO Unknown" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

// New external display; Sunshine captures its DP-1 connector.
output "PNP(LTM) LCD 0x01010101" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

// The kernel already reports the panel's 270-degree mounting orientation.
// niri composes this transform with that orientation: do NOT apply it twice.
output "eDP-1" {
    mode "800x1280@59.999"
    scale 1.5
    transform "normal"
    position x=1920 y=0
}
